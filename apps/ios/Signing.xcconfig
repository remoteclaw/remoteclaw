// Default signing values for shared/repo builds.
// Auto-selected local team overrides live in .local-signing.xcconfig (git-ignored).
// Manual local overrides can go in LocalSigning.xcconfig (git-ignored).

#include "build/Version.xcconfig"

REMOTECLAW_CODE_SIGN_STYLE = Manual
REMOTECLAW_CODE_SIGN_IDENTITY = Apple Development
REMOTECLAW_CODE_SIGN_ENTITLEMENTS = Sources/RemoteClaw.entitlements
REMOTECLAW_DEVELOPMENT_TEAM = FWJYW4S8P8

REMOTECLAW_APP_BUNDLE_ID = org.remoteclaw.app
REMOTECLAW_SHARE_BUNDLE_ID = org.remoteclaw.app.share
REMOTECLAW_APP_GROUP_ID = group.org.remoteclaw.app.shared
REMOTECLAW_WATCH_APP_BUNDLE_ID = org.remoteclaw.app.watchkitapp
REMOTECLAW_ACTIVITY_WIDGET_BUNDLE_ID = org.remoteclaw.app.activitywidget
REMOTECLAW_APNS_ENTITLEMENT_ENVIRONMENT = development

REMOTECLAW_APP_PROFILE = org.remoteclaw.app Development
REMOTECLAW_SHARE_PROFILE = org.remoteclaw.app.share Development
REMOTECLAW_ACTIVITY_WIDGET_PROFILE =
REMOTECLAW_WATCH_APP_PROFILE =

// Keep local includes after defaults: xcconfig is evaluated top-to-bottom,
// so later assignments in local files override the defaults above.
#include? ".local-signing.xcconfig"
#include? "LocalSigning.xcconfig"

// Debug products install alongside release products and keep their app-group data separate.
REMOTECLAW_DEBUG_APP_BUNDLE_ID = $(REMOTECLAW_APP_BUNDLE_ID).debug
REMOTECLAW_DEBUG_SHARE_BUNDLE_ID = $(REMOTECLAW_DEBUG_APP_BUNDLE_ID).share
REMOTECLAW_DEBUG_ACTIVITY_WIDGET_BUNDLE_ID = $(REMOTECLAW_DEBUG_APP_BUNDLE_ID).activitywidget
REMOTECLAW_DEBUG_WATCH_APP_BUNDLE_ID = $(REMOTECLAW_DEBUG_APP_BUNDLE_ID).watchkitapp
REMOTECLAW_DEBUG_APP_GROUP_ID = $(REMOTECLAW_APP_GROUP_ID).debug
