{
  "name": "@remoteclaw/diagnostics-prometheus",
  "version": "2026.5.27",
  "description": "RemoteClaw diagnostics Prometheus exporter for runtime metrics.",
  "repository": {
    "type": "git",
    "url": "https://github.com/remoteclaw/remoteclaw"
  },
  "type": "module",
  "devDependencies": {
    "remoteclaw": "workspace:*"
  },
  "remoteclaw": {
    "extensions": [
      "./index.ts"
    ],
    "install": {
      "clawhubSpec": "clawhub:@remoteclaw/diagnostics-prometheus",
      "npmSpec": "@remoteclaw/diagnostics-prometheus",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.4.25"
    },
    "compat": {
      "pluginApi": ">=2026.5.27"
    },
    "build": {
      "remoteclawVersion": "2026.5.27"
    },
    "release": {
      "publishToClawHub": true,
      "publishToNpm": true
    }
  }
}
